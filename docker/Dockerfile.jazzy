FROM ros:jazzy-ros-base-noble

# Debian 12 ARM64 主机通过 Ubuntu 24.04 容器使用官方 Jazzy 二进制包。
ENV DEBIAN_FRONTEND=noninteractive

# 代理只在镜像构建步骤中生效，不写入最终容器运行环境。
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ARG UBUNTU_MIRROR=https://mirrors.ustc.edu.cn/ubuntu-ports
ARG ROS2_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/ros2/ubuntu
ARG PYPI_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple

RUN sed -i "s|http://ports.ubuntu.com/ubuntu-ports|${UBUNTU_MIRROR}|g" \
        /etc/apt/sources.list.d/ubuntu.sources \
    && sed -i "s|http://packages.ros.org/ros2/ubuntu|${ROS2_MIRROR}|g" \
        /etc/apt/sources.list.d/ros2.sources \
    && sed -i 's/^Types: deb deb-src$/Types: deb/' \
        /etc/apt/sources.list.d/ros2.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        python3-colcon-common-extensions \
        python3-numpy \
        python3-pip \
        python3-scipy \
        python3-yaml \
        ros-jazzy-controller-manager \
        ros-jazzy-camera-calibration \
        ros-jazzy-camera-info-manager \
        ros-jazzy-compressed-image-transport \
        ros-jazzy-cv-bridge \
        ros-jazzy-foxglove-bridge \
        ros-jazzy-image-proc \
        ros-jazzy-image-transport \
        ros-jazzy-image-view \
        ros-jazzy-joint-state-broadcaster \
        ros-jazzy-joint-state-publisher \
        ros-jazzy-nav2-behaviors \
        ros-jazzy-nav2-bt-navigator \
        ros-jazzy-nav2-collision-monitor \
        ros-jazzy-nav2-controller \
        ros-jazzy-nav2-lifecycle-manager \
        ros-jazzy-nav2-map-server \
        ros-jazzy-nav2-navfn-planner \
        ros-jazzy-nav2-planner \
        ros-jazzy-nav2-regulated-pure-pursuit-controller \
        ros-jazzy-nav2-smoother \
        ros-jazzy-nav2-velocity-smoother \
        ros-jazzy-nav2-waypoint-follower \
        ros-jazzy-position-controllers \
        ros-jazzy-pointcloud-to-laserscan \
        ros-jazzy-robot-state-publisher \
        ros-jazzy-rtabmap-odom \
        ros-jazzy-rtabmap-slam \
        ros-jazzy-rtabmap-util \
        ros-jazzy-ros2controlcli \
        ros-jazzy-stereo-image-proc \
        ros-jazzy-usb-cam \
        ros-jazzy-velocity-controllers \
        ros-jazzy-xacro \
        v4l-utils \
    && python3 -m pip install --break-system-packages --no-cache-dir \
        --index-url "${PYPI_MIRROR}" plyfile==1.1.3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
