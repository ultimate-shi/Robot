<?xml version="1.0"?>
<!-- 使用方法：由 robot_description/description.launch.py 展开并发布完整机器人模型。 -->
<robot name="robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- mode 只决定 ros2_control 插件；模型、关节和控制接口保持完全一致。 -->
  <xacro:arg name="hardware_plugin" default="mock_components/GenericSystem"/>
  <xacro:arg name="servo_calibration_file" default=""/>
  <xacro:arg name="device_candidates" default="/dev/ttyACM0,/dev/ttyACM1,/dev/ttyACM2"/>
  <xacro:arg name="serial_timeout_ms" default="500"/>
  <xacro:arg name="inter_command_delay_ms" default="3"/>
  <xacro:arg name="discovery_retry_count" default="20"/>
  <xacro:arg name="discovery_retry_delay_ms" default="700"/>
  <xacro:arg name="encoder_query_delay_ms" default="20"/>
  <xacro:arg name="command_timeout_ms" default="500"/>
  <xacro:arg name="wheel_diameter" default="0.110"/>
  <xacro:arg name="sonar_lpf_alpha" default="0.2"/>
  <xacro:arg name="sonar_min_valid_mm" default="30"/>
  <xacro:arg name="sonar_max_valid_mm" default="2500"/>

  <!-- 引入xacro文件 -->
  <xacro:include filename="materials.xacro"/>
  <xacro:include filename="lap.xacro"/>
  <xacro:include filename="shin.xacro"/>
  <xacro:include filename="motor.xacro"/>
  <xacro:include filename="wheel.xacro"/>
  <xacro:include filename="radar-front.xacro"/>
  <xacro:include filename="radar-side.xacro"/>
  <xacro:include filename="sonar.xacro"/>
  <xacro:include filename="imu.xacro"/>
  <xacro:include filename="stereo_camera.xacro"/>
  <xacro:include filename="head.xacro"/>
  <xacro:include filename="hardware.xacro"/>

  <!-- 新增：动态获取robot包的绝对路径（核心！） -->
  <xacro:property name="pkg_path" value="$(find robot_description)"/>

  <!-- 基础连杆（作为机器人根节点） -->
  <link name="base_link">
    <!-- 为base_link添加简单可视化（方便在RViz中定位） -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0 0 0"/> <!-- 小方块作为base_link可视化 -->
      </geometry>
      <xacro:get_material_by_name material_name="pla_gray_light"/>
    </visual>
  </link>

  <!-- 身体链接（保留核心可视化、碰撞、惯性，移除gazebo标签） -->
  <link name="body">
    <!-- 视觉属性 -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/body.obj"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <xacro:get_material_by_name material_name="pla_gray_light"/>
    </visual>
    
    <!-- 碰撞属性（保留，不影响可视化，仅为完整性） -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/body.obj"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    
    <!-- 惯性属性（保留，不影响可视化，仅为完整性） -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.001"/>
    </inertial>
  </link>

  <!-- 底盘与身体的固定关节（保留） -->
  <joint name="base_body_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 ${pi/2}"/>
    <parent link="base_link"/>
    <child link="body"/>
  </joint>
  
  <!-- 大腿部分（保留所有lap宏调用，确保关节可被GUI控制） -->
  <!-- 右前大腿 - 原样 -->
  <xacro:lap suffix="fr" 
             parent_link="body"
             lower="${-pi/6}" upper="${pi/4}"
             xyz="-0.091 -0.072 0.158"
             rpy="0 0 0"
             mesh_scale="0.001 0.001 0.001"/>
  
  <!-- 左前大腿 - Y轴镜像 -->
  <xacro:lap suffix="fl" 
             parent_link="body"
             lower="${-pi/4}" upper="${pi/6}"
             xyz="0.091 -0.072 0.158"
             rpy="0 0 0"
             mesh_scale="-0.001 0.001 0.001"/> <!-- Y轴镜像 -->
  
  <!-- 右后大腿 - X轴镜像 -->
  <xacro:lap suffix="rr" 
             parent_link="body"
             lower="${-pi/4}" upper="${pi/6}"
             xyz="-0.091 0.072 0.158"
             rpy="0 0 0"
             mesh_scale="0.001 -0.001 0.001"/> <!-- X轴镜像 -->
  
  <!-- 左后大腿 - X和Y轴都镜像 -->
  <xacro:lap suffix="rl" 
             parent_link="body"
             lower="${-pi/6}" upper="${pi/4}"
             xyz="0.091 0.072 0.158"
             rpy="0 0 0"
             mesh_scale="-0.001 -0.001 0.001"/> <!-- X和Y轴镜像 -->


  <!-- 小腿部分 -->
  <!-- 右前小腿 -->
  <xacro:shin suffix="fr" 
              parent_link="lap_fr"
              mimic_joint="lap_body_joint_fr"
              xyz="-0.017 -0.060 0"
              rpy="0 0 0"
              mesh_scale="0.001 0.001 0.001"/>

  <!-- 左前小腿（Y轴镜像） -->
  <xacro:shin suffix="fl" 
              parent_link="lap_fl"
              mimic_joint="lap_body_joint_fl"
              xyz="0.017 -0.060 0"
              rpy="0 0 0"
              mesh_scale="-0.001 0.001 0.001"/>

  <!-- 右后小腿（X轴镜像） -->
  <xacro:shin suffix="rr" 
              parent_link="lap_rr"
              mimic_joint="lap_body_joint_rr"
              xyz="-0.017 0.060 0"
              rpy="0 0 0"
              mesh_scale="0.001 -0.001 0.001"/>

  <!-- 左后小腿（X和Y轴镜像） -->
  <xacro:shin suffix="rl" 
              parent_link="lap_rl"
              mimic_joint="lap_body_joint_rl"
              xyz="0.017 0.060 0"
              rpy="0 0 0"
              mesh_scale="-0.001 -0.001 0.001"/>

  <!-- 转向部分 -->
  <xacro:motor suffix="fr" 
              parent_link="shin_fr"
              joint_position="front_right"
              xyz="-0.008 0 -0.069"                   
              rpy="0 0 0"
              mesh_scale="0.001 0.001 0.001"/>
  <xacro:motor suffix="fl" 
              parent_link="shin_fl"
              joint_position="front_left"
              xyz="0.008 0 -0.069"                   
              rpy="0 0 0"
              mesh_scale="-0.001 0.001 0.001"/>
  <xacro:motor suffix="rr" 
              parent_link="shin_rr"
              joint_position="rear_right"
              xyz="-0.008 0 -0.069"                   
              rpy="0 0 0"
              mesh_scale="0.001 -0.001 0.001"/>
  <xacro:motor suffix="rl" 
              parent_link="shin_rl"
              joint_position="rear_left"
              xyz="0.008 0 -0.069"                   
              rpy="0 0 0"
              mesh_scale="-0.001 -0.001 0.001"/>


  <!-- 轮胎部分-->
  <xacro:wheel suffix="fr"
             parent_link="motor_fr"
             joint_position="front_right"
             xyz="0.015 0 -0.085"
             rpy="0 0 0"
             mesh_scale="0.001 0.001 0.001"/>
  <xacro:wheel suffix="fl"
             parent_link="motor_fl"
             joint_position="front_left"
             xyz="-0.015 0 -0.085"
             rpy="0 0 0"
             mesh_scale="-0.001 0.001 0.001"/>
  <xacro:wheel suffix="rr"
             parent_link="motor_rr"
             joint_position="rear_right"
             xyz="0.015 0 -0.085"
             rpy="0 0 0"
             mesh_scale="0.001 -0.001 0.001"/>
  <xacro:wheel suffix="rl"
             parent_link="motor_rl"
             joint_position="rear_left"
             xyz="-0.015 0 -0.085"
             rpy="0 0 0"
             mesh_scale="-0.001 -0.001 0.001"/>

  <!-- 前超声波传感器-->
  <xacro:radar-front suffix="fr"
              parent_link="motor_fr"
              xyz="0 -0.037 -0.011"
              rpy="0 0 0"
              mesh_scale="0.001 0.001 0.001"/>
  <xacro:radar-front suffix="fl"
              parent_link="motor_fl"
              xyz="0 -0.037 -0.011"
              rpy="0 0 0"
              mesh_scale="-0.001 0.001 0.001"/>
  <xacro:radar-front suffix="rr"
              parent_link="motor_rr"
              xyz="0 0.037 -0.011"
              rpy="0 0 0"
              mesh_scale="0.001 -0.001 0.001"/>
  <xacro:radar-front suffix="rl"
              parent_link="motor_rl"
              xyz="0 0.037 -0.011"
              rpy="0 0 0"
              mesh_scale="-0.001 -0.001 0.001"/>

  <!-- 侧超声波传感器-->
  <xacro:radar-side suffix="fr"
              parent_link="shin_fr"
              xyz="-0.026 -0.009 -0.035"
              rpy="0 0 0"
              mesh_scale="0.001 0.001 0.001"/>
  <xacro:radar-side suffix="fl"
              parent_link="shin_fl"
              xyz="0.026 -0.009 -0.035"
              rpy="0 0 0"
              mesh_scale="-0.001 0.001 0.001"/>
  <xacro:radar-side suffix="rr"
              parent_link="shin_rr"
              xyz="-0.026 0.009 -0.035"
              rpy="0 0 0"
              mesh_scale="0.001 -0.001 0.001"/>
  <xacro:radar-side suffix="rl"
              parent_link="shin_rl"
              xyz="0.026 0.009 -0.035"
              rpy="0 0 0"
              mesh_scale="-0.001 -0.001 0.001"/>

  <!-- 实机固定超声波：前3、后3、左1、右1，位置来自 hw_ctrl/chassis.json。 -->
  <xacro:sonar_frame name="sonar_fl" parent="base_link" xyz="0.201 0.058 0.03" yaw="${pi/6}"/>
  <xacro:sonar_frame name="sonar_fc" parent="base_link" xyz="0.215 0 0.03" yaw="0"/>
  <xacro:sonar_frame name="sonar_fr" parent="base_link" xyz="0.201 -0.058 0.03" yaw="${-pi/6}"/>
  <xacro:sonar_frame name="sonar_right" parent="base_link" xyz="0 -0.142 0.03" yaw="${-pi/2}"/>
  <xacro:sonar_frame name="sonar_rr" parent="base_link" xyz="-0.190 -0.062 0.03" yaw="${-2*pi/3}"/>
  <xacro:sonar_frame name="sonar_rc" parent="base_link" xyz="-0.200 0 0.03" yaw="${pi}"/>
  <xacro:sonar_frame name="sonar_rl" parent="base_link" xyz="-0.190 0.062 0.03" yaw="${2*pi/3}"/>
  <xacro:sonar_frame name="sonar_left" parent="base_link" xyz="0 0.142 0.03" yaw="${pi/2}"/>

  <!--  插入 IMU（修改安装位置即可） -->
  <xacro:imu
    parent_link="body"   
    x="0.0"                        
    y="0.0"                        
    z="0.15"                       
    roll="0"
    pitch="0"
    yaw="0"
  />

  <!--
    两自由度头部安装在 body 前方中线。当前位姿依据参考图和网格边界设置，
    实机装配完成后应测量安装面并校准 xyz/rpy。
  -->
  <xacro:head parent_link="body"
              xyz="0 -0.145 0.205"
              rpy="0 0 0"
              mesh_scale="0.001 0.001 0.001"/>
              
  <!--
    双目摄像头安装在头部上半部分内部；两个 OBJ 共享局部装配原点，
    相机镜头中心与面罩的左右孔重合。
  -->
  <xacro:stereo_camera parent_link="head_pitch_link"
                       xyz="0 0 0"
                       rpy="0 0 0"
                       baseline="0.061145213"/>

  <xacro:hardware hardware_plugin="$(arg hardware_plugin)"
                  servo_calibration_file="$(arg servo_calibration_file)"
                  device_candidates="$(arg device_candidates)"
                  serial_timeout_ms="$(arg serial_timeout_ms)"
                  inter_command_delay_ms="$(arg inter_command_delay_ms)"
                  discovery_retry_count="$(arg discovery_retry_count)"
                  discovery_retry_delay_ms="$(arg discovery_retry_delay_ms)"
                  encoder_query_delay_ms="$(arg encoder_query_delay_ms)"
                  command_timeout_ms="$(arg command_timeout_ms)"
                  wheel_diameter="$(arg wheel_diameter)"
                  sonar_lpf_alpha="$(arg sonar_lpf_alpha)"
                  sonar_min_valid_mm="$(arg sonar_min_valid_mm)"
                  sonar_max_valid_mm="$(arg sonar_max_valid_mm)"/>

</robot>
