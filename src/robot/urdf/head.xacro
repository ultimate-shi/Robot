<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="head_module">

  <!--
    两自由度头部模块：下部绕 Z 轴控制 yaw，上部绕 X 轴控制 pitch。
    OBJ 使用毫米建模，因此默认缩放为 0.001；安装位姿由调用处相对 body 设置。
  -->
  <xacro:macro name="head"
               params="parent_link
                       xyz:='0 0 0'
                       rpy:='0 0 0'
                       mesh_scale:='0.001 0.001 0.001'
                       pitch_joint_xyz:='0 0 0.0478'">

    <!-- 头部下半部分：随 yaw 关节转动。 -->
    <link name="head_yaw_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robot/meshes/yaw_camera.obj"
                scale="${mesh_scale}"/>
        </geometry>
        <xacro:get_material_by_name material_name="pla_blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robot/meshes/yaw_camera.obj"
                scale="${mesh_scale}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.024" rpy="0 0 0"/>
        <mass value="0.25"/>
        <inertia ixx="0.00012" ixy="0.0" ixz="0.0"
                 iyy="0.00012" iyz="0.0" izz="0.00010"/>
      </inertial>
    </link>

    <!-- yaw 轴竖直，初始限制为左右各 90 度。 -->
    <joint name="head_yaw_joint" type="revolute">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <parent link="${parent_link}"/>
      <child link="head_yaw_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-pi / 2.0}" upper="${pi / 2.0}"
             effort="3.0" velocity="1.0"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <!-- 头部上半部分：局部 X 轴为 pitch 转轴。 -->
    <link name="head_pitch_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robot/meshes/pitch_camera.obj"
                scale="${mesh_scale}"/>
        </geometry>
        <xacro:get_material_by_name material_name="pla_blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robot/meshes/pitch_camera.obj"
                scale="${mesh_scale}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.036" rpy="0 0 0"/>
        <mass value="0.30"/>
        <inertia ixx="0.00025" ixy="0.0" ixz="0.0"
                 iyy="0.00020" iyz="0.0" izz="0.00018"/>
      </inertial>
    </link>

    <!-- pitch 初始限制为上下各 45 度，后续可按实机舵机限位校准。 -->
    <joint name="head_pitch_joint" type="revolute">
      <origin xyz="${pitch_joint_xyz}" rpy="0 0 0"/>
      <parent link="head_yaw_link"/>
      <child link="head_pitch_link"/>
      <axis xyz="1 0 0"/>
      <limit lower="${-pi / 4.0}" upper="${pi / 4.0}"
             effort="3.0" velocity="1.0"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>

  </xacro:macro>

</robot>
